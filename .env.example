VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Legacy alternative if the project still uses the anon key:
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Stripe keys are server-only. Configure these in Vercel, not in VITE_ variables.
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
APP_BASE_URL=http://localhost:3000

# Nur serverseitig. Die Kontolöschung und der
# optionale Stripe-Webhook verwenden diesen Schlüssel. Nie mit VITE_ benennen.
# Der Schlüssel muss Auth-Admin und die für service_role freigegebenen RPCs
# unterstützen. Der Browser verwendet ausschliesslich den öffentlichen Schlüssel.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVER_SECRET_KEY
# Optional legacy name accepted by the server:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
