VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Legacy alternative if the project still uses the anon key:
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Stripe keys are server-only. Configure these in Vercel, not in VITE_ variables.
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
APP_BASE_URL=http://localhost:3000

# Server-only Supabase secret used by the signed Stripe webhook ledger.
# Use the project's service_role key or a secret key with table insert/select access.
# Never expose either value through a VITE_ variable.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVER_SECRET_KEY
# Optional legacy name accepted by the server:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
